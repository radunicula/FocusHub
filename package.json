{
  "name": "focushub",
  "version": "1.0.0",
  "private": true,
  "description": "Customizable productivity dashboard and start page",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "node scripts/build-js.mjs",
    "watch:js": "node scripts/build-js.mjs --watch",
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./vendor/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./tailwind.input.css -o ./vendor/tailwind.css --watch"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tailwindcss": "3.4.17"
  }
}
